# Copia este fichero a .env y ajusta los valores.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://raspberrypi.local
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
GUNICORN_WORKERS=1
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Catálogo Bandai TCG+ ---
# Endpoint paginado que devuelve las cartas del juego. Revisa cards/bandai.py
# si el formato de la respuesta cambia.
BANDAI_API_URL=https://api.bandai-tcg-plus.com/api/user/card/list
BANDAI_GAME_TITLE_ID=
BANDAI_PAGE_SIZE=100
BANDAI_SYNC_HOUR=4

# Caché de imágenes oficiales (dentro del contenedor; ./data está montado en /app/data)
CARD_IMAGES_DIR=/app/data/card_images

# --- Identificación ---
# Distancia combinada pHash+dHash (0-128) por debajo de la cual la coincidencia
# se considera segura sin recurrir a ORB.
MATCH_HASH_THRESHOLD=20
MATCH_ORB_CANDIDATES=8
MATCH_MIN_CONFIDENCE=0.55
SCAN_RETENTION_DAYS=30

# --- Cámara (solo con --profile camera) ---
CAMERA_DEVICE=/dev/video0
CAMERA_URL=http://camera:8080
# La Trust QHD ofrece MJPEG en 2560x1440, 1920x1080 y 640x480 (no 1280x720).
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=15
CAMERA_FOURCC=MJPG
CAMERA_PREVIEW_WIDTH=960
# Controles v4l2 aplicados al arrancar, en orden (ver `v4l2-ctl -d /dev/video0 --list-ctrls`).
# Con soporte a distancia fija: desactiva el autofoco y fija focus_absolute (20-800).
CAMERA_CONTROLS=
